---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Mail, Phone, Linkedin, MapPin, Send } from "lucide-astro";
---

<BaseLayout
  title="Contact | Dishant Shakya"
  description="Get in touch with Dishant Shakya for investment analysis, equity research, and financial consulting inquiries."
>
  <!-- Page Header -->
  <section class="py-20 bg-primary-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold text-white mb-4">Get in Touch</h1>
      <p class="text-lg text-gray-400 max-w-2xl">
        Interested in discussing investment opportunities or need professional analysis? I'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-white mb-6">Contact Information</h2>
          <div class="space-y-6">
            <a
              href="mailto:dishantshakya01@gmail.com"
              class="flex items-start gap-4 group"
            >
              <div class="w-10 h-10 rounded-lg bg-accent-500/10 flex items-center justify-center shrink-0 group-hover:bg-accent-500/20 transition-colors">
                <Mail class="w-5 h-5 text-accent-400" />
              </div>
              <div>
                <p class="text-sm text-gray-400 mb-0.5">Email</p>
                <p class="text-gray-300 group-hover:text-accent-400 transition-colors">
                  dishantshakya01@gmail.com
                </p>
              </div>
            </a>

            <a href="tel:+9779841051475" class="flex items-start gap-4 group">
              <div class="w-10 h-10 rounded-lg bg-accent-500/10 flex items-center justify-center shrink-0 group-hover:bg-accent-500/20 transition-colors">
                <Phone class="w-5 h-5 text-accent-400" />
              </div>
              <div>
                <p class="text-sm text-gray-400 mb-0.5">Phone</p>
                <p class="text-gray-300 group-hover:text-accent-400 transition-colors">
                  +977 9841051475
                </p>
              </div>
            </a>

            <a
              href="https://www.linkedin.com/in/dishant-shakya-671b8a297/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 group"
            >
              <div class="w-10 h-10 rounded-lg bg-accent-500/10 flex items-center justify-center shrink-0 group-hover:bg-accent-500/20 transition-colors">
                <Linkedin class="w-5 h-5 text-accent-400" />
              </div>
              <div>
                <p class="text-sm text-gray-400 mb-0.5">LinkedIn</p>
                <p class="text-gray-300 group-hover:text-accent-400 transition-colors">
                  Dishant Shakya
                </p>
              </div>
            </a>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-accent-500/10 flex items-center justify-center shrink-0">
                <MapPin class="w-5 h-5 text-accent-400" />
              </div>
              <div>
                <p class="text-sm text-gray-400 mb-0.5">Location</p>
                <p class="text-gray-300">Kathmandu, Nepal</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <form id="contact-form" class="p-8 rounded-2xl bg-primary-900/40 border border-primary-800/50">
            <h2 class="text-2xl font-bold text-white mb-6">Send a Message</h2>
            <input type="hidden" name="access_key" value="3a293181-100b-4fa2-a711-8223b3851a30" />
            <input type="hidden" name="from_name" value="Portfolio Contact Form" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-400 mb-2">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-lg bg-primary-950/50 border border-primary-800 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-400 mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-lg bg-primary-950/50 border border-primary-800 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                  placeholder="your@email.com"
                />
              </div>
            </div>
            <div class="mt-5">
              <label for="subject" class="block text-sm font-medium text-gray-400 mb-2">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 rounded-lg bg-primary-950/50 border border-primary-800 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                placeholder="How can I help?"
              />
            </div>
            <div class="mt-5">
              <label for="message" class="block text-sm font-medium text-gray-400 mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-lg bg-primary-950/50 border border-primary-800 text-white placeholder-gray-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors resize-none"
                placeholder="Your message..."
              ></textarea>
            </div>
            <button
              id="submit-btn"
              type="submit"
              class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-[#0369a1] hover:bg-[#075985] disabled:opacity-60 disabled:cursor-not-allowed text-white font-semibold rounded-lg transition-colors w-full sm:w-auto justify-center"
            >
              <span id="submit-label">Send</span>
              <Send class="w-4 h-4" />
            </button>
            <p class="mt-4 text-xs text-gray-400">
              Your details are used only to reply to your message. See the
              <a href="/privacy" class="text-accent-400 hover:underline">Privacy Policy</a>.
            </p>
            <p id="form-status" role="status" aria-live="polite" class="mt-4 text-sm hidden"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const button = document.getElementById("submit-btn") as HTMLButtonElement;
  const label = document.getElementById("submit-label") as HTMLElement;
  const status = document.getElementById("form-status") as HTMLElement;

  function show(message: string, ok: boolean) {
    status.textContent = message;
    status.classList.remove("hidden", "text-green-400", "text-red-400");
    status.classList.add(ok ? "text-green-400" : "text-red-400");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    button.disabled = true;
    label.textContent = "Sending...";
    status.classList.add("hidden");

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();
      if (res.ok && result.success) {
        form.reset();
        show("Thanks! Your message has been sent. I'll get back to you soon.", true);
      } else {
        show("Something went wrong. Please try again or email me directly.", false);
      }
    } catch {
      show("Could not send your message. Please check your connection and try again.", false);
    } finally {
      button.disabled = false;
      label.textContent = "Send";
    }
  });

</script>
