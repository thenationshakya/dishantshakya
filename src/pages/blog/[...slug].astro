---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Calendar, ArrowLeft, Tag } from "lucide-astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Dishant Shakya`}
  description={post.data.description}
  ogType="article"
  articleDate={post.data.pubDate.toISOString()}
>
  <article class="py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-accent-400 transition-colors mb-8"
      >
        <ArrowLeft class="w-4 h-4" />
        Back to Blog
      </a>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="flex items-center gap-4 text-sm text-gray-400 mb-4">
          <span class="flex items-center gap-1.5">
            <Calendar class="w-4 h-4" />
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-4">
          {post.data.title}
        </h1>
        <p class="text-lg text-gray-400">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 text-xs font-medium text-accent-400 bg-accent-500/10 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Article Content -->
      <div class="blog-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .blog-content { font-size: 1.125rem; line-height: 1.85; color: #d1d5db; }
  .blog-content > * + * { margin-top: 1.75rem; }
  .blog-content h2 { margin-top: 4rem; margin-bottom: 1.25rem; font-size: 1.875rem; line-height: 1.25; font-weight: 800; color: #fff; scroll-margin-top: 6rem; }
  .blog-content h2 + * { margin-top: 0; }
  .blog-content h3 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.375rem; font-weight: 700; color: #fff; }
  .blog-content p { margin: 0; }
  .blog-content > p + p { margin-top: 1.75rem; }
  .blog-content strong { color: #fff; font-weight: 700; }
  .blog-content a { color: #38bdf8; }
  .blog-content a:hover { text-decoration: underline; }
  .blog-content ul, .blog-content ol { margin-top: 1.75rem; padding-left: 1.75rem; }
  .blog-content ul { list-style: disc outside; }
  .blog-content ol { list-style: decimal outside; }
  .blog-content li { margin-top: 0.875rem; padding-left: 0.5rem; }
  .blog-content li:first-child { margin-top: 0; }
  .blog-content li::marker { color: #38bdf8; font-weight: 600; }
  .blog-content blockquote { margin: 2.5rem 0; padding: 1rem 1.5rem; border-left: 4px solid #0ea5e9; background: rgba(14, 165, 233, 0.06); border-radius: 0 0.75rem 0.75rem 0; color: #e5e7eb; }
  .blog-content blockquote p { margin: 0; }
  .blog-content img { display: block; width: 100%; max-width: 36rem; height: auto; margin: 3rem auto 0.75rem; border-radius: 0.75rem; border: 1px solid rgba(30, 58, 95, 0.5); }
  .blog-content em { display: block; text-align: center; font-size: 0.875rem; font-style: normal; color: #9ca3af; margin-bottom: 1rem; }
  .blog-content p:has(> img) { margin-top: 0; }
  .blog-content code { color: #38bdf8; }
</style>
