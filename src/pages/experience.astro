---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Briefcase, GraduationCap, Award } from "lucide-astro";

const experiences = [
  {
    type: "work",
    title: "Investment Analyst",
    organization: "National Capital",
    period: "2022 - Present",
    description:
      "Leading equity research and investment analysis for Nepal's capital markets. Responsible for building financial models, conducting sector analysis, and delivering actionable investment recommendations to clients.",
    highlights: [
      "Conducted in-depth fundamental analysis of 50+ listed companies across NEPSE",
      "Built comprehensive DCF and comparable company valuation models",
      "Authored 20+ detailed equity research reports for institutional clients",
      "Tracked macroeconomic indicators and regulatory developments impacting capital markets",
    ],
  },
  {
    type: "work",
    title: "Junior Analyst",
    organization: "National Capital",
    period: "2020 - 2022",
    description:
      "Supported the senior research team with data collection, financial statement analysis, and market monitoring. Developed foundational skills in investment analysis and financial modeling.",
    highlights: [
      "Assisted in preparing quarterly earnings analysis for key NEPSE sectors",
      "Maintained and updated financial databases and valuation spreadsheets",
      "Monitored daily market activity and prepared morning market briefs",
      "Contributed to sector-specific research notes on banking and hydropower industries",
    ],
  },
  {
    type: "education",
    title: "Bachelor's in Business Administration (Finance)",
    organization: "Tribhuvan University",
    period: "2016 - 2020",
    description:
      "Focused on corporate finance, investment management, and financial economics. Developed strong analytical and quantitative skills through coursework and independent research.",
    highlights: [
      "Specialized in corporate finance and investment analysis",
      "Completed coursework in financial economics and portfolio theory",
      "Active member of the university finance and investment club",
    ],
  },
  {
    type: "certification",
    title: "CFA Level I Candidate",
    organization: "CFA Institute",
    period: "2023",
    description:
      "Pursuing the Chartered Financial Analyst designation to deepen expertise in investment analysis, portfolio management, and ethical standards.",
    highlights: [
      "Studying quantitative methods, economics, and financial reporting",
      "Deepening knowledge of equity valuation and fixed-income analysis",
    ],
  },
];

const iconMap = {
  work: Briefcase,
  education: GraduationCap,
  certification: Award,
};
---

<BaseLayout
  title="Experience | Dishant Shakya"
  description="Professional experience and career milestones of Dishant Shakya, Investment Analyst at National Capital. Equity research, financial modeling, and market analysis."
>
  <!-- Page Header -->
  <section class="py-20 bg-primary-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold text-white mb-4">Professional Journey</h1>
      <p class="text-lg text-gray-400 max-w-2xl">
        A timeline of my career milestones, from academic foundations to professional achievements in investment analysis.
      </p>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-4 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-primary-800"></div>

        {experiences.map((exp, index) => {
          const Icon = iconMap[exp.type as keyof typeof iconMap];
          const isLeft = index % 2 === 0;

          return (
            <div class="relative mb-12 last:mb-0">
              {/* Timeline Dot */}
              <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-primary-900 border-2 border-accent-500 flex items-center justify-center z-10">
                <Icon class="w-4 h-4 text-accent-400" />
              </div>

              {/* Content Card */}
              <div
                class:list={[
                  "ml-14 md:ml-0 md:w-[calc(50%-2rem)]",
                  isLeft ? "md:mr-auto md:pr-4" : "md:ml-auto md:pl-4",
                ]}
              >
                <div class="p-6 rounded-2xl bg-primary-900/40 border border-primary-800/50 hover:border-accent-500/20 transition-colors">
                  <span class="inline-block px-3 py-1 text-xs font-medium text-accent-400 bg-accent-500/10 rounded-full mb-3">
                    {exp.period}
                  </span>
                  <h3 class="text-xl font-bold text-white mb-1">{exp.title}</h3>
                  <p class="text-accent-400 text-sm font-medium mb-3">{exp.organization}</p>
                  <p class="text-gray-400 text-sm leading-relaxed mb-4">{exp.description}</p>
                  <ul class="space-y-2">
                    {exp.highlights.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-gray-500">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-accent-500 shrink-0" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
