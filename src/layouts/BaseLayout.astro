---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article";
  articleDate?: string;
}

const { title, description, ogImage, ogType, articleDate } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      articleDate={articleDate}
    />
  </head>
  <body class="bg-primary-950 text-gray-100 font-sans antialiased">
    <Header />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: rgba(56, 189, 248, 0.3);
    color: white;
  }

  html {
    scrollbar-width: thin;
    scrollbar-color: #1e3a5f #091628;
  }
</style>
