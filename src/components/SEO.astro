---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  articleDate?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og-default.jpg",
  ogType = "website",
  articleDate,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dishant Shakya",
  jobTitle: "Investment Analyst",
  email: "dishantshakya01@gmail.com",
  telephone: "+977-9841051475",
  url: siteUrl,
  sameAs: ["https://www.linkedin.com/in/dishant-shakya-671b8a297/"],
  worksFor: {
    "@type": "Organization",
    name: "National Capital",
  },
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Dishant Shakya - Investment Analyst",
  description: "Professional investment analysis, equity research, and financial modeling services.",
  url: siteUrl,
  provider: {
    "@type": "Person",
    name: "Dishant Shakya",
  },
  areaServed: "Nepal",
  serviceType: ["Investment Analysis", "Equity Research", "Financial Modeling", "Market Analysis"],
};

const articleSchema = articleDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(/ | Dishant Shakya$/, ""),
      description,
      datePublished: articleDate,
      dateModified: articleDate,
      image: fullOgImage,
      mainEntityOfPage: canonical,
      author: { "@type": "Person", name: "Dishant Shakya", url: siteUrl },
      publisher: { "@type": "Person", name: "Dishant Shakya", url: siteUrl },
    }
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Dishant Shakya, Investment Analyst" />
<meta property="og:site_name" content="Dishant Shakya" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullOgImage} />

{articleDate && <meta property="article:published_time" content={articleDate} />}

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
