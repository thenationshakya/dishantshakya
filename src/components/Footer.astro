---
import { Linkedin, Mail, Phone } from "lucide-astro";
---

<footer class="bg-primary-950 border-t border-primary-800/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <a href="/" class="text-xl font-bold text-white tracking-tight">
          Dishant<span class="text-accent-400">.</span>
        </a>
        <p class="mt-3 text-gray-400 text-sm leading-relaxed">
          Investment Analyst specializing in equity research, financial modeling, and market analysis.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-sm text-gray-400 hover:text-accent-400 transition-colors">Home</a></li>
          <li><a href="/experience" class="text-sm text-gray-400 hover:text-accent-400 transition-colors">Experience</a></li>
          <li><a href="/blog" class="text-sm text-gray-400 hover:text-accent-400 transition-colors">Blog</a></li>
          <li><a href="/contact" class="text-sm text-gray-400 hover:text-accent-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Get in Touch</h3>
        <ul class="space-y-3">
          <li>
            <a href="mailto:dishant.shakya@nationalcapital.com.np" class="flex items-center gap-2 text-sm text-gray-400 hover:text-accent-400 transition-colors">
              <Mail class="w-4 h-4" />
              dishant.shakya@nationalcapital.com.np
            </a>
          </li>
          <li>
            <a href="tel:+9779841051475" class="flex items-center gap-2 text-sm text-gray-400 hover:text-accent-400 transition-colors">
              <Phone class="w-4 h-4" />
              +977 9841051475
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/dishant-shakya-671b8a297/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm text-gray-400 hover:text-accent-400 transition-colors">
              <Linkedin class="w-4 h-4" />
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-primary-800/50 text-center">
      <p class="text-sm text-gray-500">
        &copy; {new Date().getFullYear()} Dishant Shakya. All rights reserved.
      </p>
    </div>
  </div>
</footer>
